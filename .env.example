# Google Cloud Service Account (used in all environments)
GCP_PROJECT_ID=
GCP_CLIENT_EMAIL=
# For GCP_PRIVATE_KEY, either paste with real newlines or use escaped \n
# If using escaped newlines, the code replaces \\n with real newlines at runtime
GCP_PRIVATE_KEY=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback/spotify

# Auth secret
AUTH_SECRET=your_nextauth_secret

# Google AI (GenKit)
GEMINI_API_KEY=

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000